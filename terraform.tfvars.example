region          = "us-east-1"
project_name    = "devops-project"
cluster_name    = "devops-eks-cluster"
node_group_name = "devops-managed-nodes"
node_group_size = 2
instance_type   = "t3.medium"

# Replace with your public IPv4 address without /32.
public_ip = "203.0.113.10"

# Replace after the application load balancer has been created.
web_alb_name = "replace-with-alb-name"

# Must be globally unique.
bucket_name = "replace-with-unique-terraform-state-bucket"

dynamodb_table = "terraform-locks"
domain_name     = "example.com"
web_acl_name    = "devops-cloudfront-waf"
cdn_name        = "devops-cloudfront-distribution"
